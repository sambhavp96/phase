{
  "expo": {
    "name": "Phase",
    "slug": "phase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "phase",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "xyz.sanaandshav.phase"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F2426",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "xyz.sanaandshav.phase"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F2426",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1c80ecc3-3405-4677-9b11-ddcdd0df2349"
      }
    },
    "owner": "sanaandshav",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1c80ecc3-3405-4677-9b11-ddcdd0df2349"
    }
  }
}
